DATABASE_URL="postgresql://zhangben:zhangben@localhost:5433/zhangben?schema=public"

# JWT_SECRET 必须 ≥32 字符的随机值，生成：openssl rand -base64 48
# 未配置或使用默认值/弱值，后端会拒绝启动（安全要求）
JWT_SECRET=""

# 首次启动（空库）创建管理员时使用；不填则自动生成一次性随机密码，
# 只在容器日志中显示一次，请立即登录修改。
ADMIN_PASSWORD=""

PORT=8080

# 跨域白名单（逗号分隔）。默认关闭跨域（生产走 Nginx 同源反代不需要）
# CORS_ORIGIN="https://your-domain.example"
